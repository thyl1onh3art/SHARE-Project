# SHARE Project Security Configuration Template
# Copy this file to .env and update with your actual values

# ===========================================
# JWT & Authentication
# ===========================================
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_secure_12345_change_this_in_production
JWT_EXPIRES_IN=7d

# ===========================================
# Database Security
# ===========================================
MONGODB_URI=mongodb://localhost:27017/share_project
# For production, use: mongodb://username:password@host:port/database?authSource=admin&ssl=true

# ===========================================
# SSL/TLS Configuration
# ===========================================
HTTPS_PORT=5443
SSL_CERT_PATH=./cert.pem
SSL_KEY_PATH=./key.pem

# ===========================================
# Backup Security
# ===========================================
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here_change_this_in_production
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=30

# ===========================================
# Two-Factor Authentication
# ===========================================
# Twilio Configuration (for SMS 2FA)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Email Configuration (for Email 2FA)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email_user_here
EMAIL_PASS=your_email_password_here
EMAIL_FROM=noreply@shareproject.com

# ===========================================
# Rate Limiting & Security
# ===========================================
# Global rate limiting
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=1000

# Login rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Registration rate limiting
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=3

# 2FA rate limiting
TWO_FACTOR_RATE_LIMIT_WINDOW_MS=300000
TWO_FACTOR_RATE_LIMIT_MAX_ATTEMPTS=3

# ===========================================
# CORS & Security Headers
# ===========================================
CORS_ORIGIN=http://localhost:3000
# For production, specify exact domains: https://yourdomain.com,https://www.yourdomain.com

# ===========================================
# Application Security
# ===========================================
NODE_ENV=development
PORT=5000

# Session security
SESSION_SECRET=your_session_secret_here_change_this_in_production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=strict

# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false

# ===========================================
# Monitoring & Logging
# ===========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
SECURITY_LOG_FILE_PATH=./logs/security.log

# ===========================================
# Production Security (uncomment for production)
# ===========================================
# NODE_ENV=production
# SESSION_COOKIE_SECURE=true
# CORS_ORIGIN=https://yourdomain.com
# MONGODB_URI=mongodb://username:password@host:port/database?authSource=admin&ssl=true

# ===========================================
# Additional Security Features
# ===========================================
# Enable additional security features
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
ENABLE_WAF=true
ENABLE_BACKUP_ENCRYPTION=true
ENABLE_TWO_FACTOR_AUTH=true

# IP whitelist (comma-separated)
IP_WHITELIST=127.0.0.1,::1,::ffff:127.0.0.1

# IP blacklist (comma-separated)
IP_BLACKLIST=

# ===========================================
# Backup Configuration
# ===========================================
BACKUP_SCHEDULE_DAILY=true
BACKUP_SCHEDULE_WEEKLY=true
BACKUP_SCHEDULE_MONTHLY=true
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true

# ===========================================
# Security Monitoring
# ===========================================
ENABLE_SECURITY_MONITORING=true
SECURITY_ALERT_EMAIL=security@shareproject.com
SECURITY_ALERT_PHONE=+1234567890

# ===========================================
# Development vs Production
# ===========================================
# Development settings (default)
DEVELOPMENT_MODE=true
SKIP_EMAIL_VERIFICATION=false
SKIP_2FA_SETUP=false

# Production settings (uncomment for production)
# DEVELOPMENT_MODE=false
# SKIP_EMAIL_VERIFICATION=false
# SKIP_2FA_SETUP=false
